# 로컬 docker-compose 실행용 환경변수 예시 파일입니다.
# 사용법: 이 파일을 .env로 복사한 뒤 필요하면 값을 바꾸세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 git에 커밋되지 않습니다.
#
# 아래 값은 전부 로컬 개발/테스트 전용 더미 자격증명입니다. 운영(NHN Cloud) 배포 시에는
# 여기 값을 그대로 쓰지 말고 K8s Secret/OpenBao 등으로 별도 주입하세요.

# PostgreSQL
POSTGRES_DB=productdb
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password

# RabbitMQ
# guest 계정은 기본적으로 loopback 접속만 허용되어 컨테이너 간 통신 시 거부되므로
# 별도 계정을 사용합니다.
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app_password

# MinIO (로컬 전용: NHN Cloud Object Storage 대체)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
OBJECT_STORAGE_BUCKET=product-images

# 실제 NHN Cloud Object Storage 배포 시에만 설정합니다. 공개 URL이
# /v1/AUTH_<계정ID>/<버킷>/<key> 형식이 되도록 image-processing-service에서 사용합니다.
# 로컬 MinIO는 이 경로 구조가 없으므로 비워둡니다.
OBJECT_STORAGE_ACCOUNT_ID=
